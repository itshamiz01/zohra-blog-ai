# ================================================================
# ZOHRA AUTONOMOUS PUBLISHING ENGINE — Environment Configuration
# ================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real credentials.
# ================================================================

# --- Application ---
APP_NAME=zohra-publisher
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://zohra:zohra_dev_password@localhost:5432/zohra_publisher

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Logging ---
LOG_LEVEL=INFO

# --- Authentication ---
# Generate a hash: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$EXAMPLE_HASH_REPLACE_ME

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Timezone ---
DEFAULT_TIMEZONE=UTC

# --- AI Cost Budgets ---
LLM_DAILY_BUDGET=10.00
LLM_MONTHLY_BUDGET=200.00

# --- Feature Flags ---
ENABLE_DISCOVERY=true
ENABLE_RESEARCH=true
ENABLE_WRITING=true
ENABLE_AUTO_PUBLISH=true
ENABLE_ANALYTICS=true

# --- Autonomy ---
AUTONOMY_ENABLED=true
MAINTENANCE_MODE=true

# --- Part 2: Discovery Engine ---
DISCOVERY_DEFAULT_INTERVAL_MINUTES=15
MAX_FETCH_CONCURRENCY=10
MAX_DOMAIN_CONCURRENCY=2
FETCH_TIMEOUT_SECONDS=15.0
MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=5
EVENT_CLUSTER_WINDOW_HOURS=48
EVENT_SIMILARITY_THRESHOLD=0.70
POSSIBLE_EVENT_THRESHOLD=0.45
MIN_TREND_SCORE_FOR_HANDOFF=60.0
MIN_CONFIDENCE_FOR_HANDOFF=60.0
RAW_CONTENT_RETENTION_DAYS=7
MAX_DISCOVERY_COST_PER_DAY=15.00

# ================================================================
# FUTURE INTEGRATIONS (Not required for Part 1 startup)
# ================================================================

# --- WordPress ---
# WORDPRESS_URL=https://yourblog.com
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=

# --- Google ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- LLM Providers & Routing ---
# LLM_PRIMARY_PROVIDER=openrouter  # options: openrouter, openai, gemini
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_ENABLED=true
# OPENROUTER_WRITING_MODEL=openai/gpt-4o  # or anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct
# OPENROUTER_RESEARCH_MODEL=openai/gpt-4o-mini  # or meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_VERIFICATION_MODEL=openai/gpt-4o-mini
# OPENROUTER_TIMEOUT_SECONDS=60.0
# OPENROUTER_MAX_RETRIES=3
# OPENROUTER_SITE_URL=https://zohra.ai
# OPENROUTER_APP_NAME=Zohra-Publisher
#
# OPENAI_API_KEY=
# OPENAI_WRITING_MODEL=gpt-4o
# OPENAI_RESEARCH_MODEL=gpt-4o-mini
# OPENAI_VERIFICATION_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=60.0
# OPENAI_MAX_RETRIES=3
# GEMINI_ENABLED=false
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Heavenly Insights Publishing Target ---
# HEAVENLY_SITE_URL=https://heavenly-insights-educator.hamidansari1795.chatgpt.site
# HEAVENLY_API_URL=https://heavenly-insights-educator.hamidansari1795.chatgpt.site/api/posts
# HEAVENLY_API_TOKEN=PASTE_GENERATED_TOKEN_HERE
# Upload the generated cover to POST {HEAVENLY_SITE_URL}/api/images so the post
# references a public absolute URL. Leave this ON: a relative "/storage/..." path
# is not served by the blog and renders as a broken image.
# HEAVENLY_UPLOAD_IMAGES=true

# --- Article Cover Images ---
# Every published article must carry a cover image.
# ARTICLE_FEATURED_IMAGE_REQUIRED=true
# ARTICLE_IMAGE_FAILURE_POLICY=BLOCK
# When true (default), a failed generative attempt degrades to a procedural or
# deterministic placeholder cover instead of publishing an imageless article.
# ARTICLE_IMAGE_GUARANTEE_IMAGE=true
# ARTICLE_IMAGE_PROVIDER=local_ai   # local_ai | openai | pollinations | procedural
# ARTICLE_IMAGE_MAX_REGENERATIONS=2
# ARTICLE_IMAGE_RELEVANCE_MIN_SCORE=70.0
# ARTICLE_IMAGE_ALLOW_PROCEDURAL_FALLBACK=false
# ARTICLE_IMAGE_REQUIRE_GENERATIVE_AI=true
# ARTICLE_IMAGE_DAILY_BUDGET=10.0

# --- Reddit Opportunity & Referral Engine ---
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_USER_AGENT=ZohraBot/1.0 (Content Intelligence; by /u/YourRedditUsername)
# REDDIT_USERNAME=your_reddit_username
# REDDIT_PASSWORD=your_reddit_password
# REDDIT_REFRESH_TOKEN=
#
# Safe Defaults (Real posting strictly disabled initially):
REDDIT_ENABLED=false
REDDIT_DISCOVERY_ENABLED=true
REDDIT_RESPONSE_GENERATION_ENABLED=false
REDDIT_POSTING_ENABLED=false
REDDIT_AUTONOMY_MODE=DISCOVERY_ONLY
# Autonomy Modes: REDDIT_OFF, DISCOVERY_ONLY, DRAFT_RESPONSES, APPROVAL_REQUIRED, AUTO_LOW_RISK
#
REDDIT_MAX_COMMENTS_PER_DAY=5
REDDIT_MAX_COMMENTS_PER_SUBREDDIT_PER_DAY=1
REDDIT_MIN_HOURS_BETWEEN_POSTS=4.0
REDDIT_MIN_OPPORTUNITY_SCORE=65.0
REDDIT_MIN_RELEVANCE_SCORE=60.0
